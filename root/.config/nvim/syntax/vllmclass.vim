" vLLM 调用栈与调用树中的核心类；仅在 syntax=vllmclass 的 buffer 启用。
if exists('b:current_syntax')
  finish
endif

syntax case match

" 按职责分组，类名后的方法名保持原样，方便沿链路识别模块边界。
syntax keyword vllmClassEngine LLMEngine AsyncLLM EngineCore EngineCoreProc InprocClient SyncMPClient AsyncMPClient
syntax keyword vllmClassScheduler Scheduler
syntax keyword vllmClassKV KVCacheManager KVCacheCoordinator UnitaryKVCacheCoordinator HybridKVCacheCoordinator SingleTypeKVCacheManager FullAttentionManager BlockPool KVCacheBlock
syntax keyword vllmClassWorker UniProcExecutor MultiprocExecutor WorkerWrapperBase Worker GPUModelRunner
syntax keyword vllmClassModel DeepseekV2ForCausalLM DeepseekV32ForCausalLM DeepseekV32Model DeepseekV32DecoderLayer DeepseekV32Attention
syntax keyword vllmClassHiSparseCoordinator HiSparseCoordinator HiSparseSourceManager HiSparseHotManager HiSparseResidentManager
syntax keyword vllmClassHiSparseConnector HiSparseConnector HiSparseConnectorScheduler HiSparseConnectorWorker
syntax keyword vllmClassHiSparseRuntime HiSparseRuntime HiSparseCacheHandle HiSparseIndexGroup HiSparseMLAIndexGroup HiSparseHostPool
syntax keyword vllmClassOutput OutputProcessor RequestOutput

" 链接到主题颜色，不覆盖用户自定义颜色，也不依赖 GUI/终端色值。
highlight default link vllmClassEngine Function
highlight default link vllmClassScheduler Statement
highlight default link vllmClassKV Type
highlight default link vllmClassWorker Identifier
highlight default link vllmClassModel Constant
highlight default link vllmClassHiSparseCoordinator Special
highlight default link vllmClassHiSparseConnector PreProc
highlight default link vllmClassHiSparseRuntime Underlined
highlight default link vllmClassOutput Added

let b:current_syntax = 'vllmclass'
